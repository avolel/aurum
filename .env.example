# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Postgres ---
POSTGRES_DB=aurum
POSTGRES_USER=aurum
POSTGRES_PASSWORD=change-me-locally

# --- API ---
# Connection string the API uses to reach Postgres inside the compose network.
ConnectionStrings__Aurum=Host=postgres;Port=5432;Database=aurum;Username=aurum;Password=change-me-locally

# Host-side override for `dotnet ef`, read by AurumDbContextFactory. Nothing in
# docker-compose.yml maps this into a container, so it affects tooling only.
#
# The line above says Host=postgres, which resolves only inside the compose network. Commands that
# actually open a connection -- `database update`, `dbcontext script` -- run on your machine, where
# that name does not resolve and the error is a DNS failure with nothing pointing at the cause.
# Compose publishes 5432, so localhost reaches the same database.
#
# `migrations add` and `migrations script` never connect and do not need this.
AURUM_DESIGN_CONNECTION=Host=localhost;Port=5432;Database=aurum;Username=aurum;Password=change-me-locally

# --- Price sources ---
# All three keys are required for every switched-on source; a blank one stops the app at startup.
# Each free tier has a MONTHLY request quota. See Pricing/Quota for how it is enforced.
PriceSources__GoldApiIo__ApiKey=
PriceSources__ApiNinjas__ApiKey=
PriceSources__MetalpriceApi__ApiKey=
# Only GoldAPI's limit is overridable here: it is the one expected to change, with the paid plan
# (D-8). The other two limits, and every source's QuotaPeriod, come from appsettings.json.
PriceSources__GoldApiIo__MonthlyRequestLimit=100
# Switch a source off without touching appsettings.json. api-ninjas is the primary (Priority 1),
# so switching it off is the fallback check. That makes goldapi.io the primary, and its 100 requests
# cannot fund a 15-minute interval: raise PricePolling__PollInterval at the same time or the app
# refuses to start.
PriceSources__GoldApiIo__Enabled=true
PriceSources__ApiNinjas__Enabled=true
PriceSources__MetalpriceApi__Enabled=true
# A poll costs up to PriceFeed__Resilience__MaxAttempts requests, not one, and the boot guard
# multiplies by it (D-15). At 3 attempts, 15m is 8,928 requests against api-ninjas' 10,000; 5m
# implies 26,784 and the process refuses to start.
PricePolling__PollInterval=00:15:00
PriceFeed__Resilience__MaxAttempts=3

# --- Ollama ---
Ollama__BaseUrl=http://ollama:11434
